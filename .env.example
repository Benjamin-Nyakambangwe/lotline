# --- Database ---
DATABASE_URL=postgres://lotline:CHANGE_ME@localhost:5432/lotline

# --- App and auth ---
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The first account allowed to sign in; it becomes the admin and can invite others.
OWNER_EMAIL=
# console (print magic links in the terminal) | link-copy (admin copies invite links) | resend
AUTH_EMAIL_MODE=console
RESEND_API_KEY=
EMAIL_FROM=

# --- Web Push (generate once: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- ABC API (worker only) ---
ABC_API_BASE=https://app-api.abcauctions.co.zw/lots
ABC_SITE_BASE=https://app.abcauctions.co.zw
ABC_USER_AGENT=Mozilla/5.0
ABC_MAX_CONCURRENCY=6
ABC_RATE_PER_SEC=3
ABC_DAILY_CAP=40000
# Kill switch: set to false to stop all polling (links keep working).
ABC_POLLING_ENABLED=true

# --- Worker cadence (defaults are production values) ---
WORKER_HEALTH_PORT=8081
SYNC_EVERY_MIN_DAY=10
SYNC_EVERY_MIN_NIGHT=30
SOLD_SWEEP_EVERY_MIN=180
ENRICH_EVERY_MS=3000
# For local development against the real ABC, be lighter, e.g.:
#   ABC_RATE_PER_SEC=1  SYNC_EVERY_MIN_DAY=60  ENRICH_EVERY_MS=10000

DISPLAY_TZ=Africa/Harare
LOG_LEVEL=info
